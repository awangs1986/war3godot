<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:W3Editor.Services"
        xmlns:rnd="using:W3Editor.Rendering"
        x:Class="W3Editor.MainWindow"
        Title="W3 编辑器 — 未打开地图"
        Width="1480" Height="920"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- ============ 菜单栏 ============ -->
    <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Border Width="22" Height="22" Margin="10,0,8,0" CornerRadius="5"
                  VerticalAlignment="Center" Background="{StaticResource Gold}">
            <TextBlock Text="W3" FontSize="10" FontWeight="Bold" Foreground="#17181C"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Menu VerticalAlignment="Center" Background="Transparent">
            <MenuItem x:Name="MenuFile" Header="文件(_F)">
              <MenuItem x:Name="MenuNewMap" Header="新建地图…" Click="OnNewMap" InputGesture="Ctrl+N" />
              <MenuItem x:Name="MenuOpenMap" Header="打开地图…" Click="OnOpenMap" InputGesture="Ctrl+O" />
              <Separator />
              <MenuItem x:Name="MenuSave" Header="保存地图" Click="OnSave" IsEnabled="False" InputGesture="Ctrl+S" />
              <MenuItem x:Name="MenuExport" Header="另存为 d1map…" Click="OnSaveAsNative" IsEnabled="False" />
              <Separator />
              <MenuItem Header="在 Godot 中预览" Click="OnGodotPreview" />
              <Separator />
              <MenuItem Header="退出" Click="OnExit" />
            </MenuItem>
            <MenuItem x:Name="MenuEdit" Header="编辑(_E)">
              <MenuItem x:Name="MenuUndo" Header="撤销" Click="OnUndo" IsEnabled="False" InputGesture="Ctrl+Z" />
              <MenuItem x:Name="MenuRedo" Header="重做" Click="OnRedo" IsEnabled="False" InputGesture="Ctrl+Y" />
              <Separator />
              <MenuItem x:Name="MenuTileSetter" Header="更换图块集…" Click="OnTileSetter" />
              <MenuItem x:Name="MenuTilePathing" Header="全局图块寻路…" Click="OnTilePathing" />
            </MenuItem>
            <MenuItem x:Name="MenuView" Header="视图(_V)">
              <MenuItem x:Name="MenuOverlayPathing" Header="寻路覆盖层" ToggleType="CheckBox" Click="OnOverlayToggled" IsEnabled="False" />
              <MenuItem x:Name="MenuOverlayDoodads" Header="装饰物显示" ToggleType="CheckBox" Click="OnOverlayToggled" IsEnabled="False" />
              <MenuItem x:Name="MenuOverlayUnits" Header="单位显示" ToggleType="CheckBox" Click="OnOverlayToggled" IsEnabled="False" />
              <Separator />
              <MenuItem Header="线框网格" IsEnabled="False" ToolTip.Tip="占位 · P1（3D 视口交互化）" />
            </MenuItem>
            <MenuItem Header="工具(_T)">
              <MenuItem Header="地形编辑" Tag="Terrain" Click="OnModeMenuClicked" />
              <MenuItem Header="装饰物" Tag="Doodads" Click="OnModeMenuClicked" />
              <MenuItem Header="单位" Tag="Units" Click="OnModeMenuClicked" />
              <MenuItem Header="寻路" Tag="Pathing" Click="OnModeMenuClicked" />
              <MenuItem Header="区域" Tag="Regions" Click="OnModeMenuClicked" />
              <Separator />
              <MenuItem x:Name="MenuPlugins" Header="插件" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
              <MenuItem Header="关于 W3 编辑器" Click="OnAbout" />
            </MenuItem>
          </Menu>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ 工具栏 ============ -->
    <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2">
          <Button x:Name="BtnOpen" Classes="tool" Click="OnOpenMap">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="icon" Text="&#xE838;" Foreground="{StaticResource Gold}" />
              <TextBlock Text="打开" />
            </StackPanel>
          </Button>
          <Button x:Name="BtnSave" Classes="tool" Click="OnSave" IsEnabled="False" ToolTip.Tip="保存当前地图">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="icon" Text="&#xE74E;" />
              <TextBlock Text="保存" />
            </StackPanel>
          </Button>
          <Button x:Name="BtnExport" Classes="tool" Click="OnSaveAsNative" IsEnabled="False" ToolTip.Tip="另存为原生 d1map 地图">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="icon" Text="&#xE898;" />
              <TextBlock Text="导出" />
            </StackPanel>
          </Button>

          <Border Width="1" Background="{StaticResource Stroke}" Margin="8,4" />

          <Button x:Name="BtnUndo" Classes="tool" Click="OnUndo" IsEnabled="False" ToolTip.Tip="撤销 (Ctrl+Z)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="icon" Text="&#xE7A7;" />
              <TextBlock Text="撤销" />
            </StackPanel>
          </Button>
          <Button x:Name="BtnRedo" Classes="tool" Click="OnRedo" IsEnabled="False" ToolTip.Tip="重做 (Ctrl+Y)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="icon" Text="&#xE7A6;" />
              <TextBlock Text="重做" />
            </StackPanel>
          </Button>

          <Border Width="1" Background="{StaticResource Stroke}" Margin="8,4" />

          <ToggleButton x:Name="BtnToggleLeftSidebar" Classes="tool" IsChecked="True"
                        Click="OnToggleLeftSidebar" ToolTip.Tip="显示/隐藏左侧小地图面板">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="icon" Text="&#xE8A5;" />
              <TextBlock Text="小地图面板" />
            </StackPanel>
          </ToggleButton>

          <Border Width="1" Background="{StaticResource Stroke}" Margin="8,4" />

          <!-- 编辑模式分段控件 -->
          <Border Background="{StaticResource BgInput}" CornerRadius="8" Padding="3">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton x:Name="BtnModeTerrain" Classes="tool" Content="地形" IsChecked="True" Tag="Terrain" Click="OnModeClicked" ToolTip.Tip="地形笔刷（右侧“地形”页）" />
              <ToggleButton x:Name="BtnModeDoodads" Classes="tool" Content="装饰物" Tag="Doodads" Click="OnModeClicked" ToolTip.Tip="装饰物/可破坏物摆放（3D 视口）" />
              <ToggleButton x:Name="BtnModeUnits" Classes="tool" Content="单位" Tag="Units" Click="OnModeClicked" ToolTip.Tip="单位摆放（3D 视口）" />
              <ToggleButton x:Name="BtnModePathing" Classes="tool" Content="寻路" Tag="Pathing" Click="OnModeClicked" ToolTip.Tip="在 2D/3D 地面直接绘制寻路标志；右键清除" />
              <ToggleButton x:Name="BtnModeRegions" Classes="tool" Content="区域" Tag="Regions" Click="OnModeClicked" ToolTip.Tip="在 2D/3D 地面拖出矩形区域" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Button DockPanel.Dock="Right" Classes="primary" Click="OnGodotPreview"
                ToolTip.Tip="启动独立 Godot 窗口预览当前打开的地图">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Classes="icon" Text="&#xE768;" />
            <TextBlock Text="独立预览" />
          </StackPanel>
        </Button>
        <ToggleButton x:Name="BtnView3D" DockPanel.Dock="Right" Classes="tool" Margin="0,0,8,0"
                      IsEnabled="False" Click="OnView3DToggled"
                      ToolTip.Tip="内置 GL 渲染器：右键平移 · 中键/Ctrl+右键旋转 · 滚轮缩放 · 方向键平移 · G 网格 · Home 复位 · 左键刷地形">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Classes="icon" Text="&#xE774;" />
            <TextBlock Text="3D 视口" />
          </StackPanel>
        </ToggleButton>
      </DockPanel>
    </Border>

    <!-- ============ 状态栏 ============ -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,1,0,0" Padding="12,5">
      <DockPanel>
        <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}"
                   FontSize="12" Text="视口：2D 俯视" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="8" Height="8" Fill="#7CC46A" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusLeft" Foreground="{StaticResource TextPrimary}" FontSize="12" Text="就绪" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ 主体三栏 ============ -->
    <Grid x:Name="MainLayoutGrid" ColumnDefinitions="264,6,*,6,316" Margin="8">

      <!-- 左侧栏 -->
      <Border x:Name="LeftSidebar" Grid.Column="0" Classes="card">
        <ContentControl x:Name="LeftPanelHost" />
      </Border>

      <!-- 中央视口 -->
      <Border Grid.Column="2" Classes="card" Background="{StaticResource ViewportBg}" ClipToBounds="True">
        <Panel x:Name="ViewportPanel" Background="Transparent">
          <Image x:Name="ViewportImage" Stretch="Uniform" Margin="20" />
          <StackPanel x:Name="ViewportHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <TextBlock Text="&#xE826;" Classes="icon" FontSize="44" Foreground="#4A4336"
                       HorizontalAlignment="Center" />
            <TextBlock Text="视口占位" FontSize="20" Foreground="#8F8571" HorizontalAlignment="Center" />
            <TextBlock Text="文件 → 打开地图…（.w3x / 已解压目录 / .w3e）显示俯视预览" Foreground="#6B6455" HorizontalAlignment="Center" />
            <TextBlock Text="打开地图后点工具栏“3D 视口”，使用内置 GL 渲染器实时编辑" Foreground="#6B6455" HorizontalAlignment="Center" />
          </StackPanel>
          <rnd:GlTerrainViewport x:Name="GlView" IsVisible="False" />
          <!-- Overlays must sit above GlView so brush ring / marquee stay visible in 3D. -->
          <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="BrushCursor" Stroke="{StaticResource Gold}" StrokeThickness="2"
                     Fill="#22E8B84B" IsVisible="False" />
            <Rectangle x:Name="SelectRect" Stroke="#7CC46A" StrokeThickness="1.5"
                       Fill="#227CC46A" IsVisible="False" />
          </Canvas>
          <Border x:Name="ViewportBadge" IsVisible="False" Background="#D91E2025" CornerRadius="7"
                  BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,6">
            <TextBlock x:Name="ViewportBadgeText" Foreground="{StaticResource TextPrimary}" FontSize="12" />
          </Border>
        </Panel>
      </Border>

      <!-- 右侧工具面板 -->
      <Border x:Name="RightSidebar" Grid.Column="4" Classes="card">
        <TabControl x:Name="ToolTabs" Padding="6,0" Margin="4,4,4,0" SelectionChanged="OnToolTabChanged">
          <TabControl.Styles>
            <Style Selector="TabItem">
              <Setter Property="FontSize" Value="13" />
              <Setter Property="MinHeight" Value="38" />
              <Setter Property="Padding" Value="10,0" />
            </Style>
          </TabControl.Styles>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
