<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:svc="using:W3Editor.Services"
        xmlns:rnd="using:W3Editor.Rendering"
        x:Class="W3Editor.MainWindow"
        Title="W3 编辑器 — 未打开地图"
        Width="1480" Height="920"
        WindowStartupLocation="CenterScreen">

  <DockPanel>

    <!-- ============ 菜单栏 ============ -->
    <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Border Width="22" Height="22" Margin="10,0,8,0" CornerRadius="5"
                  VerticalAlignment="Center" Background="{StaticResource Gold}">
            <TextBlock Text="W3" FontSize="10" FontWeight="Bold" Foreground="#17181C"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Menu VerticalAlignment="Center" Background="Transparent">
            <MenuItem Header="文件(_F)">
              <MenuItem Header="新建地图…" Click="OnNewMap" InputGesture="Ctrl+N" />
              <MenuItem Header="打开地图…" Click="OnOpenMap" InputGesture="Ctrl+O" />
              <Separator />
              <MenuItem x:Name="MenuSave" Header="保存地图" Click="OnSave" IsEnabled="False" InputGesture="Ctrl+S" />
              <MenuItem x:Name="MenuExport" Header="另存为 d1map…" Click="OnSaveAsNative" IsEnabled="False" />
              <Separator />
              <MenuItem Header="在 Godot 中预览" Click="OnGodotPreview" />
              <Separator />
              <MenuItem Header="退出" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="编辑(_E)">
              <MenuItem x:Name="MenuUndo" Header="撤销" Click="OnUndo" IsEnabled="False" InputGesture="Ctrl+Z" />
              <MenuItem x:Name="MenuRedo" Header="重做" Click="OnRedo" IsEnabled="False" InputGesture="Ctrl+Y" />
              <Separator />
              <MenuItem Header="更换图块集…" Click="OnTileSetter" />
              <MenuItem Header="全局图块寻路…" Click="OnTilePathing" />
            </MenuItem>
            <MenuItem Header="视图(_V)">
              <MenuItem x:Name="MenuOverlayPathing" Header="寻路覆盖层" ToggleType="CheckBox" Click="OnOverlayToggled" IsEnabled="False" />
              <MenuItem x:Name="MenuOverlayDoodads" Header="装饰物显示" ToggleType="CheckBox" Click="OnOverlayToggled" IsEnabled="False" />
              <MenuItem x:Name="MenuOverlayUnits" Header="单位显示" ToggleType="CheckBox" Click="OnOverlayToggled" IsEnabled="False" />
              <Separator />
              <MenuItem Header="线框网格" IsEnabled="False" ToolTip.Tip="占位 · P1（3D 视口交互化）" />
            </MenuItem>
            <MenuItem Header="工具(_T)">
              <MenuItem Header="地形编辑" Tag="Terrain" Click="OnModeMenuClicked" />
              <MenuItem Header="装饰物" Tag="Doodads" Click="OnModeMenuClicked" />
              <MenuItem Header="单位" Tag="Units" Click="OnModeMenuClicked" />
              <MenuItem Header="寻路" IsEnabled="False" ToolTip.Tip="占位 · P7（寻路与碰撞验证）" />
              <MenuItem Header="区域" IsEnabled="False" ToolTip.Tip="占位 · P5（交互数据层）" />
              <Separator />
              <MenuItem x:Name="MenuPlugins" Header="插件" />
            </MenuItem>
            <MenuItem Header="帮助(_H)">
              <MenuItem Header="关于 W3 编辑器" Click="OnAbout" />
            </MenuItem>
          </Menu>
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ 工具栏 ============ -->
    <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,0,0,1" Padding="8,6">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="2">
          <Button Classes="tool" Click="OnOpenMap">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="icon" Text="&#xE838;" Foreground="{StaticResource Gold}" />
              <TextBlock Text="打开" />
            </StackPanel>
          </Button>
          <Button x:Name="BtnSave" Classes="tool" Click="OnSave" IsEnabled="False" ToolTip.Tip="保存当前地图">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="icon" Text="&#xE74E;" />
              <TextBlock Text="保存" />
            </StackPanel>
          </Button>
          <Button x:Name="BtnExport" Classes="tool" Click="OnSaveAsNative" IsEnabled="False" ToolTip.Tip="另存为原生 d1map 地图">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="icon" Text="&#xE898;" />
              <TextBlock Text="导出" />
            </StackPanel>
          </Button>

          <Border Width="1" Background="{StaticResource Stroke}" Margin="8,4" />

          <Button x:Name="BtnUndo" Classes="tool" Click="OnUndo" IsEnabled="False" ToolTip.Tip="撤销 (Ctrl+Z)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="icon" Text="&#xE7A7;" />
              <TextBlock Text="撤销" />
            </StackPanel>
          </Button>
          <Button x:Name="BtnRedo" Classes="tool" Click="OnRedo" IsEnabled="False" ToolTip.Tip="重做 (Ctrl+Y)">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="icon" Text="&#xE7A6;" />
              <TextBlock Text="重做" />
            </StackPanel>
          </Button>

          <Border Width="1" Background="{StaticResource Stroke}" Margin="8,4" />

          <ToggleButton x:Name="BtnToggleLeftSidebar" Classes="tool" IsChecked="True"
                        Click="OnToggleLeftSidebar" ToolTip.Tip="显示/隐藏左侧小地图面板">
            <StackPanel Orientation="Horizontal" Spacing="7">
              <TextBlock Classes="icon" Text="&#xE8A5;" />
              <TextBlock Text="小地图面板" />
            </StackPanel>
          </ToggleButton>

          <Border Width="1" Background="{StaticResource Stroke}" Margin="8,4" />

          <!-- 编辑模式分段控件 -->
          <Border Background="{StaticResource BgInput}" CornerRadius="8" Padding="3">
            <StackPanel Orientation="Horizontal" Spacing="2">
              <ToggleButton x:Name="BtnModeTerrain" Classes="tool" Content="地形" IsChecked="True" Tag="Terrain" Click="OnModeClicked" ToolTip.Tip="地形笔刷（右侧“地形”页）" />
              <ToggleButton x:Name="BtnModeDoodads" Classes="tool" Content="装饰物" Tag="Doodads" Click="OnModeClicked" ToolTip.Tip="装饰物/可破坏物摆放（3D 视口）" />
              <ToggleButton x:Name="BtnModeUnits" Classes="tool" Content="单位" Tag="Units" Click="OnModeClicked" ToolTip.Tip="单位摆放（3D 视口）" />
              <ToggleButton Classes="tool" Content="寻路" IsEnabled="False" ToolTip.Tip="占位 · P7（寻路与碰撞验证）" />
              <ToggleButton Classes="tool" Content="区域" IsEnabled="False" ToolTip.Tip="占位 · P5（交互数据层）" />
            </StackPanel>
          </Border>
        </StackPanel>

        <Button DockPanel.Dock="Right" Classes="primary" Click="OnGodotPreview"
                ToolTip.Tip="启动独立 Godot 窗口预览当前打开的地图">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Classes="icon" Text="&#xE768;" />
            <TextBlock Text="独立预览" />
          </StackPanel>
        </Button>
        <ToggleButton x:Name="BtnView3D" DockPanel.Dock="Right" Classes="tool" Margin="0,0,8,0"
                      IsEnabled="False" Click="OnView3DToggled"
                      ToolTip.Tip="内置 GL 渲染器：右键平移 · 中键/Ctrl+右键旋转 · 滚轮缩放 · 方向键平移 · G 网格 · Home 复位 · 左键刷地形">
          <StackPanel Orientation="Horizontal" Spacing="7">
            <TextBlock Classes="icon" Text="&#xE774;" />
            <TextBlock Text="3D 视口" />
          </StackPanel>
        </ToggleButton>
      </DockPanel>
    </Border>

    <!-- ============ 状态栏 ============ -->
    <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}"
            BorderBrush="{StaticResource StrokeSoft}" BorderThickness="0,1,0,0" Padding="12,5">
      <DockPanel>
        <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Foreground="{StaticResource TextMuted}"
                   FontSize="12" Text="视口：2D 俯视" />
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Ellipse Width="8" Height="8" Fill="#7CC46A" VerticalAlignment="Center" />
          <TextBlock x:Name="StatusLeft" Foreground="{StaticResource TextPrimary}" FontSize="12" Text="就绪" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ============ 主体三栏 ============ -->
    <Grid x:Name="MainLayoutGrid" ColumnDefinitions="264,6,*,6,316" Margin="8">

      <!-- 左侧栏 -->
      <Border x:Name="LeftSidebar" Grid.Column="0" Classes="card">
        <ScrollViewer>
          <StackPanel Margin="14,12" Spacing="10">
            <DockPanel>
              <Button DockPanel.Dock="Right" Classes="tool" Width="28" Height="28" Padding="0"
                      Click="OnHideLeftSidebar" ToolTip.Tip="隐藏左侧面板">
                <TextBlock Classes="icon" Text="&#xE711;" FontSize="12" HorizontalAlignment="Center" />
              </Button>
              <TextBlock Classes="sectionTitle" Text="小地图" VerticalAlignment="Center" />
            </DockPanel>
            <Border Background="{StaticResource ViewportBg}" CornerRadius="8"
                    BorderBrush="{StaticResource Stroke}" BorderThickness="1" Height="222">
              <Panel>
                <Image x:Name="MinimapImage" Stretch="Uniform" Margin="8" />
                <TextBlock x:Name="MinimapHint" Text="未打开地图" Foreground="#6B6455"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Border Width="14" Height="14" Margin="5" BorderBrush="{StaticResource Gold}"
                        BorderThickness="2,2,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Border Width="14" Height="14" Margin="5" BorderBrush="{StaticResource Gold}"
                        BorderThickness="0,2,2,0" HorizontalAlignment="Right" VerticalAlignment="Top" />
                <Border Width="14" Height="14" Margin="5" BorderBrush="{StaticResource Gold}"
                        BorderThickness="2,0,0,2" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                <Border Width="14" Height="14" Margin="5" BorderBrush="{StaticResource Gold}"
                        BorderThickness="0,0,2,2" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
              </Panel>
            </Border>

            <TextBlock Classes="sectionTitle" Text="地图信息" Margin="0,6,0,0" />
            <Border Background="{StaticResource BgElevated}" CornerRadius="8" Padding="10,8">
              <StackPanel Spacing="7">
                <DockPanel><TextBlock Classes="fieldLabel" Width="78" Text="来源" /><TextBlock x:Name="InfoSource" Classes="fieldValue" Text="-" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding #InfoSource.Text}" /></DockPanel>
                <DockPanel><TextBlock Classes="fieldLabel" Width="78" Text="w3e 版本" /><TextBlock x:Name="InfoVersion" Classes="fieldValue" Text="-" TextWrapping="Wrap" /></DockPanel>
                <DockPanel><TextBlock Classes="fieldLabel" Width="78" Text="地图版本" /><TextBlock x:Name="InfoW3i" Classes="fieldValue" Text="-" TextWrapping="Wrap" /></DockPanel>
                <DockPanel><TextBlock Classes="fieldLabel" Width="78" Text="图块集" /><TextBlock x:Name="InfoTileset" Classes="fieldValue" Text="-" /></DockPanel>
                <DockPanel><TextBlock Classes="fieldLabel" Width="78" Text="尺寸(格)" /><TextBlock x:Name="InfoSize" Classes="fieldValue" Text="-" TextWrapping="Wrap" /></DockPanel>
                <DockPanel><TextBlock Classes="fieldLabel" Width="78" Text="中心偏移" /><TextBlock x:Name="InfoOffset" Classes="fieldValue" Text="-" /></DockPanel>
                <DockPanel><TextBlock Classes="fieldLabel" Width="78" Text="地面纹理" /><TextBlock x:Name="InfoGroundTex" Classes="fieldValue" Text="-" TextWrapping="Wrap" /></DockPanel>
                <DockPanel><TextBlock Classes="fieldLabel" Width="78" Text="悬崖纹理" /><TextBlock x:Name="InfoCliffTex" Classes="fieldValue" Text="-" TextWrapping="Wrap" /></DockPanel>
                <DockPanel><TextBlock Classes="fieldLabel" Width="78" Text="寻路网格" /><TextBlock x:Name="InfoPathing" Classes="fieldValue" Text="-" TextWrapping="Wrap" /></DockPanel>
              </StackPanel>
            </Border>

            <TextBlock Classes="sectionTitle" Text="图层" Margin="0,6,0,0" />
            <ListBox x:Name="LayerList" IsHitTestVisible="False">
              <ListBoxItem Content="地形" />
              <ListBoxItem Content="装饰物" />
              <ListBoxItem Content="单位" />
              <ListBoxItem Content="寻路" />
            </ListBox>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <!-- 中央视口 -->
      <Border Grid.Column="2" Classes="card" Background="{StaticResource ViewportBg}" ClipToBounds="True">
        <Panel x:Name="ViewportPanel" Background="Transparent">
          <Image x:Name="ViewportImage" Stretch="Uniform" Margin="20" />
          <StackPanel x:Name="ViewportHint" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <TextBlock Text="&#xE826;" Classes="icon" FontSize="44" Foreground="#4A4336"
                       HorizontalAlignment="Center" />
            <TextBlock Text="视口占位" FontSize="20" Foreground="#8F8571" HorizontalAlignment="Center" />
            <TextBlock Text="文件 → 打开地图…（.w3x / 已解压目录 / .w3e）显示俯视预览" Foreground="#6B6455" HorizontalAlignment="Center" />
            <TextBlock Text="打开地图后点工具栏“3D 视口”，使用内置 GL 渲染器实时编辑" Foreground="#6B6455" HorizontalAlignment="Center" />
          </StackPanel>
          <rnd:GlTerrainViewport x:Name="GlView" IsVisible="False" />
          <!-- Overlays must sit above GlView so brush ring / marquee stay visible in 3D. -->
          <Canvas IsHitTestVisible="False">
            <Ellipse x:Name="BrushCursor" Stroke="{StaticResource Gold}" StrokeThickness="2"
                     Fill="#22E8B84B" IsVisible="False" />
            <Rectangle x:Name="SelectRect" Stroke="#7CC46A" StrokeThickness="1.5"
                       Fill="#227CC46A" IsVisible="False" />
          </Canvas>
          <Border x:Name="ViewportBadge" IsVisible="False" Background="#D91E2025" CornerRadius="7"
                  BorderBrush="{StaticResource StrokeSoft}" BorderThickness="1"
                  HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12" Padding="10,6">
            <TextBlock x:Name="ViewportBadgeText" Foreground="{StaticResource TextPrimary}" FontSize="12" />
          </Border>
        </Panel>
      </Border>

      <!-- 右侧工具面板 -->
      <Border Grid.Column="4" Classes="card">
        <TabControl x:Name="ToolTabs" Padding="6,0" Margin="4,4,4,0" SelectionChanged="OnToolTabChanged">
          <TabControl.Styles>
            <Style Selector="TabItem">
              <Setter Property="FontSize" Value="13" />
              <Setter Property="MinHeight" Value="38" />
              <Setter Property="Padding" Value="10,0" />
            </Style>
          </TabControl.Styles>
          <TabItem Header="地形">
            <ScrollViewer>
              <StackPanel Margin="10" Spacing="10">
                <TextBlock Classes="sectionTitle" Text="高度（左键绘制 · 右键反向）" />
                <UniformGrid Columns="2" x:Name="HeightOpGrid">
                  <ToggleButton x:Name="BtnRaise" Content="抬升" Tag="Raise" Click="OnBrushOpClicked" IsEnabled="False" Margin="0,0,5,5" HorizontalAlignment="Stretch" />
                  <ToggleButton x:Name="BtnLower" Content="降低" Tag="Lower" Click="OnBrushOpClicked" IsEnabled="False" Margin="0,0,0,5" HorizontalAlignment="Stretch" />
                  <ToggleButton x:Name="BtnPlateau" Content="整平" Tag="Plateau" Click="OnBrushOpClicked" IsEnabled="False" Margin="0,0,5,5" HorizontalAlignment="Stretch" ToolTip.Tip="把范围内地面/水面高度拉平到起笔点" />
                  <ToggleButton x:Name="BtnSmooth" Content="平滑" Tag="Smooth" Click="OnBrushOpClicked" IsEnabled="False" Margin="0,0,0,5" HorizontalAlignment="Stretch" />
                </UniformGrid>

                <TextBlock Classes="sectionTitle" Text="悬崖（层级 · 以起笔点为基准）" Margin="0,4,0,0" />
                <UniformGrid Columns="2" x:Name="CliffOpGrid">
                  <ToggleButton x:Name="BtnCliffLower2" Content="降低两层" Tag="CliffLower2" Click="OnBrushOpClicked" IsEnabled="False" Margin="0,0,5,5" HorizontalAlignment="Stretch" />
                  <ToggleButton x:Name="BtnCliffLower1" Content="降低一层" Tag="CliffLower1" Click="OnBrushOpClicked" IsEnabled="False" Margin="0,0,0,5" HorizontalAlignment="Stretch" />
                  <ToggleButton x:Name="BtnCliffRaise1" Content="升高一层" Tag="CliffRaise1" Click="OnBrushOpClicked" IsEnabled="False" Margin="0,0,5,5" HorizontalAlignment="Stretch" />
                  <ToggleButton x:Name="BtnCliffRaise2" Content="升高两层" Tag="CliffRaise2" Click="OnBrushOpClicked" IsEnabled="False" Margin="0,0,0,5" HorizontalAlignment="Stretch" />
                  <ToggleButton x:Name="BtnCliffLevel" Content="同层整平" Tag="CliffLevel" Click="OnBrushOpClicked" IsEnabled="False" Margin="0,0,5,5" HorizontalAlignment="Stretch" ToolTip.Tip="把范围内悬崖层拉平到起笔点所在层" />
                  <ToggleButton x:Name="BtnRamp" Content="坡道" Tag="Ramp" Click="OnBrushOpClicked" IsEnabled="False" Margin="0,0,0,5" HorizontalAlignment="Stretch" ToolTip.Tip="在相差一层的悬崖边沿刷出坡道（右键清除坡道标记）" />
                </UniformGrid>

                <TextBlock Classes="sectionTitle" Text="水（右键移除水）" Margin="0,4,0,0" />
                <UniformGrid Columns="2" x:Name="WaterOpGrid">
                  <ToggleButton x:Name="BtnWaterShallow" Content="浅水" Tag="WaterShallow" Click="OnBrushOpClicked" IsEnabled="False" Margin="0,0,5,5" HorizontalAlignment="Stretch" />
                  <ToggleButton x:Name="BtnWaterDeep" Content="深水" Tag="WaterDeep" Click="OnBrushOpClicked" IsEnabled="False" Margin="0,0,0,5" HorizontalAlignment="Stretch" />
                </UniformGrid>
                <DockPanel>
                  <TextBlock x:Name="LblSize" DockPanel.Dock="Right" Classes="fieldValue" Text="4" />
                  <TextBlock Classes="fieldLabel" Text="笔刷大小（角点）" />
                </DockPanel>
                <Slider x:Name="SliderSize" Minimum="1" Maximum="16" Value="4" IsEnabled="False" />
                <DockPanel>
                  <TextBlock x:Name="LblStrength" DockPanel.Dock="Right" Classes="fieldValue" Text="60%" />
                  <TextBlock Classes="fieldLabel" Text="笔刷强度（仅 MCP；交互抬升用帧时间）" />
                </DockPanel>
                <Slider x:Name="SliderStrength" Minimum="0" Maximum="100" Value="60" IsEnabled="False" />

                <TextBlock Classes="sectionTitle" Text="地面纹理（点击选择后刷绘）" Margin="0,6,0,0" />
                <ItemsControl x:Name="TexturePalette">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                </ItemsControl>
                <TextBlock x:Name="TexturePaletteHint" Classes="fieldLabel" Text="打开地图后显示该图块集的纹理" />
                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,4,0,0">
                  <Button Content="更换图块集…" Click="OnTileSetter" />
                  <Button Content="图块寻路…" Click="OnTilePathing" />
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </TabItem>
          <TabItem Header="装饰物">
            <DockPanel Margin="10">
              <TextBlock DockPanel.Dock="Top" Classes="sectionTitle" Text="装饰物调色板（点击选中 → 3D 视口左键放置）" />
              <ComboBox x:Name="DoodadCategory" DockPanel.Dock="Top" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
              <TextBox x:Name="DoodadSearch" DockPanel.Dock="Top" Watermark="按名称 / ID 过滤…" Margin="0,8,0,8" />
              <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <CheckBox x:Name="ChkRandVariation" Content="随机变体" IsChecked="True" FontSize="12" />
                  <CheckBox x:Name="ChkRandRotation" Content="随机旋转" IsChecked="True" FontSize="12" />
                  <CheckBox x:Name="ChkRandScale" Content="随机缩放" IsChecked="True" FontSize="12" />
                </StackPanel>
                <DockPanel>
                  <TextBlock Classes="fieldLabel" Text="散布间距" VerticalAlignment="Center" />
                  <TextBlock x:Name="LblScatterSpacing" Classes="fieldLabel" Text="1.0 格"
                             DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                  <Slider x:Name="SliderScatterSpacing" Minimum="0.5" Maximum="4" Value="1"
                          TickFrequency="0.5" IsSnapToTickEnabled="True" Margin="8,0,0,0" />
                </DockPanel>
                <DockPanel>
                  <TextBlock Classes="fieldLabel" Text="散布半径" VerticalAlignment="Center" />
                  <TextBlock x:Name="LblScatterRadius" Classes="fieldLabel" Text="3 格"
                             DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0" />
                  <Slider x:Name="SliderScatterRadius" Minimum="0" Maximum="8" Value="3"
                          TickFrequency="1" IsSnapToTickEnabled="True" Margin="8,0,0,0" />
                </DockPanel>
                <TextBlock x:Name="DoodadHint" Classes="fieldLabel" TextWrapping="Wrap"
                           Text="打开地图后可用。左键放置 · 拖动散布 · 空格/Esc 取消。" />
              </StackPanel>
              <ListBox x:Name="DoodadList" />
            </DockPanel>
          </TabItem>
          <TabItem Header="单位">
            <DockPanel Margin="10">
              <TextBlock DockPanel.Dock="Top" Classes="sectionTitle" Text="单位调色板（点击选中 → 3D 视口左键放置）" />
              <ComboBox x:Name="UnitOwner" DockPanel.Dock="Top" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
              <ComboBox x:Name="UnitRace" DockPanel.Dock="Top" Margin="0,8,0,0" HorizontalAlignment="Stretch" />
              <TextBox x:Name="UnitSearch" DockPanel.Dock="Top" Watermark="按名称 / ID 过滤…" Margin="0,8,0,8" />
              <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                <CheckBox x:Name="ChkUnitRandRotation" Content="随机朝向（默认 WE 270°）" FontSize="12" />
                <TextBlock x:Name="UnitHint" Classes="fieldLabel"
                           Text="打开地图后可用。左键放置 · 空格/Esc 取消。" TextWrapping="Wrap" />
              </StackPanel>
              <ListBox x:Name="UnitList" />
            </DockPanel>
          </TabItem>
          <TabItem Header="寻路">
            <StackPanel Margin="10" Spacing="10">
              <TextBlock Classes="sectionTitle" Text="寻路覆盖层（war3map.wpm）" />
              <TextBlock Classes="fieldLabel" TextWrapping="Wrap"
                         Text="在视口叠加静态寻路网格（32 单位/格）。先在“视图”菜单打开“寻路覆盖层”。" />
              <CheckBox x:Name="ChkNoWalk" Content="禁行走（红）" IsChecked="True" IsEnabled="False" Click="OnOverlayToggled" />
              <CheckBox x:Name="ChkNoFly" Content="禁飞行（蓝）" IsEnabled="False" Click="OnOverlayToggled" />
              <CheckBox x:Name="ChkNoBuild" Content="禁建造（金）" IsEnabled="False" Click="OnOverlayToggled" />
              <TextBlock x:Name="PathingHint" Classes="fieldLabel" Text="未加载 wpm。" TextWrapping="Wrap" />
              <TextBlock Classes="fieldLabel" Text="寻路笔刷编辑为 P7（寻路与碰撞验证）。" />
            </StackPanel>
          </TabItem>
          <TabItem Header="区域">
            <StackPanel Margin="10" Spacing="10">
              <TextBlock Classes="sectionTitle" Text="区域 · 占位 P5（交互数据层）" />
              <TextBlock Classes="fieldLabel" TextWrapping="Wrap"
                         Text="矩形区域框选与命名，供关卡逻辑（出生点 / 传送 / 事件触发范围）引用。" />
              <Button Content="新建区域" IsEnabled="False" />
            </StackPanel>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>
  </DockPanel>
</Window>
