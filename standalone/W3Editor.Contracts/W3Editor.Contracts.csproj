<Project Sdk="Microsoft.NET.Sdk">

  <!-- Editor module contracts, v2. Zero implementation, zero UI, zero engine.
       Modules and the Shell may reference this assembly only; they must never
       reference each other. Breaking changes require a Version bump AND a
       ContractsVersion bump in Contracts.cs (external review 4.23). -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>W3Editor.Contracts</RootNamespace>
    <Version>2.0.0</Version>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
  </PropertyGroup>

</Project>
